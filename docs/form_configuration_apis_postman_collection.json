        {
          "name": "Create Form Config V1",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "x-authenticated-user-token",
                "value": "{{user_token}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"request\": {\n    \"name\": \"Profile Form Configuration\",\n    \"type\": \"profile\",\n    \"subtype\": \"personal-details\",\n    \"portal\": \"web\",\n    \"clientVersion\": 1.0,\n    \"criteria\": {\n      \"rootOrg\": \"karmayogi\",\n      \"role\": \"PUBLIC\"\n    },\n    \"data\": {\n      \"fields\": [\n        {\n          \"name\": \"firstName\",\n          \"type\": \"text\",\n          \"required\": true\n        }\n      ]\n    }\n  }\n}"
            },
            "url": {
              "raw": "{{base_url}}/formsConfig/create",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "formsConfig",
                "create"
              ]
            }
          },
          "response": []
        },
